# Database-only backups. Both switches stay off until their separate gates pass.
DB_BACKUP_ENABLED=0
DB_BACKUP_SCHEDULE_ENABLED=0
DB_BACKUP_CLEANUP_ENABLED=0
DB_BACKUP_EXTERNAL_TRIGGER_ENABLED=0
# Inject the same >=32-character random token as GitHub Actions secret
# DB_BACKUP_TRIGGER_TOKEN only after the external workflow is configured.
# Generate 32-256 URL-safe random characters; never commit the real value.
DB_BACKUP_TRIGGER_TOKEN=INJECT_FROM_SECRET_STORE
DB_BACKUP_MODE=cloud
DB_BACKUP_STORAGE=volume
DB_BACKUP_ROLE=api
DB_BACKUP_SCHEDULER_MODE=external_api
BACKUP_ENVIRONMENT=production

# The existing Railway API volume mount, verified in the 2026-10-29 findings.
DB_BACKUP_VOLUME_DIR=/app/instance/inspection_evidence
DB_BACKUP_VOLUME_REQUIRE_MOUNT=1
# 1 GiB minimum free-space floor; observed API volume free space was ~4.49 GiB.
# Actual dump/workspace use is measured during the first authorized run.
DB_BACKUP_MIN_FREE_BYTES=1073741824

# Dedicated least-privilege database identity; inject its password privately.
BACKUP_DB_HOST=REPLACE_WITH_DATABASE_HOST
BACKUP_DB_PORT=3306
BACKUP_DB_NAME=REPLACE_WITH_APPLICATION_SCHEMA
BACKUP_DB_USER=revela_backup
BACKUP_DB_PASSWORD=INJECT_FROM_SECRET_STORE
# Public CA bundle in the existing Railway API volume (do not put PEM text in env).
BACKUP_DB_SSL_CA_FILE=/app/instance/inspection_evidence/tls/mysql-ca.pem
# Dedicated client-auth identity for the reveal_backup MySQL account. Keep the
# private key in the existing protected API volume with mode 0600.
BACKUP_DB_SSL_CERT_FILE=/app/instance/inspection_evidence/tls/backup-client-cert.pem
BACKUP_DB_SSL_KEY_FILE=/app/instance/inspection_evidence/tls/backup-client-key.pem

# Railway MySQL metadata read on 2026-10-29 reported 9.7.4. Docker pins the
# matching Oracle MySQL 9.7.4 client package and runtime checks the server major.
MYSQLDUMP_BIN=/usr/bin/mysqldump

# Optional independent HTTPS alert endpoint. Without one, failures are recorded
# in the existing admin inbox and the status/history ledger; this is not email
# and is not independent of the application database.
BACKUP_ALERT_WEBHOOK=
# Required only for recurring scheduling, not a one-time manual export.
BACKUP_HEARTBEAT_URL=https://REPLACE_WITH_WEEKLY_SUCCESS_ENDPOINT
