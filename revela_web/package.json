{
  "name": "revela_web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:mobile-detection": "node --test src/components/mobileDetection.test.js",
    "test:inactivity": "node --test src/components/inactivityPolicy.test.js",
    "test:api-usage-view": "node --test src/components/apiUsageView.test.js",
    "test:analytics": "node --test src/services/analyticsLoader.test.js src/components/analyticsCachePolicy.test.js src/components/wlcPolicy.test.js src/components/nonRegistryMonitoring.test.js src/components/sectorRiskPolicy.test.js",
    "test:spatial-analytics": "node --test src/components/hotspotPresentation.test.js src/components/mapRiskPresentation.test.js src/components/barangayOverviewPresentation.test.js",
    "test:analytics:browser": "node scripts/verify-compliance-browser.mjs analytics-smoke",
    "test:overview": "node --test src/pages/overviewPresentation.test.js src/utils/formatElapsedMinutes.test.js",
    "test:overview:browser": "node scripts/verify-compliance-browser.mjs actionable-smoke",
    "test:actionable:browser": "node scripts/verify-compliance-browser.mjs actionable-smoke",
    "test:analytics-layout:browser": "node scripts/verify-layout-browser.mjs --analytics-fixes-only",
    "test:analytics-theme:browser": "node scripts/verify-analytics-theme-browser.mjs",
    "test:layouts:browser": "node scripts/verify-layout-browser.mjs",
    "test:public-entry:browser": "npm run build && node scripts/verify-public-entry-browser.mjs",
    "test:settings:browser": "npm run build && node scripts/verify-settings-browser.mjs",
    "test:location-review": "node --test src/components/locationReviewPolicy.test.js",
    "test:barangay-map-mapping": "node --test src/components/barangayMapMapping.test.js",
    "test:dispatch-eligibility": "node --test src/components/dispatchEligibility.test.js",
    "verify:contexts": "node scripts/verify-contexts.mjs",
    "verify": "npm run lint && npm run verify:contexts && npm run test:mobile-detection && npm run test:inactivity && npm run test:api-usage-view && npm run test:analytics && npm run test:spatial-analytics && npm run test:location-review && npm run test:barangay-map-mapping && npm run test:dispatch-eligibility && npm run test:flag-source && npm run test:registry-ladder && npm run test:business-compliance && npm run build",
    "preview": "vite preview",
    "test:flag-source": "node --test src/components/flagSource.test.js",
    "test:registry-ladder": "node --test src/components/registryLadderPolicy.test.js",
    "test:business-compliance": "node --test src/components/businessCompliance.test.js",
    "test:business-compliance:browser": "node scripts/verify-compliance-browser.mjs",
    "test:green-link:browser": "node scripts/verify-compliance-browser.mjs green-link-smoke"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@react-google-maps/api": "^2.18.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "papaparse": "^5.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "sweetalert2": "^11.26.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
