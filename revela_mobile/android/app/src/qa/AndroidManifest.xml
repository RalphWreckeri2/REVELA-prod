        android:label="@string/app_name"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="revela.qa_mode"
            android:value="true" />
        <meta-data
            android:name="revela.qa_api_base"
            android:value="${QA_API_BASE}" />
